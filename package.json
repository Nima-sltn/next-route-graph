{
  "name": "next-route-graph",
  "version": "1.2.0",
  "description": "Inspect, lint, and visualize the structure of a Next.js App Router project from the terminal or SDK",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "next-route-graph": "dist/cli.js"
  },
  "files": [
    "dist",
    "docs",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "tsx --test tests/run.mjs",
    "pretest:browser": "npm run build",
    "test:browser": "node --test tests/browser/report.test.mjs",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "keywords": [
    "nextjs",
    "app-router",
    "routes",
    "cli",
    "visualization",
    "route-map",
    "mermaid",
    "linter",
    "typescript"
  ],
  "author": {
    "name": "Nima Soltanian",
    "url": "https://github.com/Nima-sltn"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Nima-sltn/next-route-graph.git"
  },
  "bugs": {
    "url": "https://github.com/Nima-sltn/next-route-graph/issues"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "picocolors": "^1.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "playwright": "^1.62.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
